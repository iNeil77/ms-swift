FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04


ARG DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_ROOT_USER_ACTION=ignore


ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/lib/ccache:/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/local/cuda/extras/CUPTI/lib64:$LD_LIBRARY_PATH \
    TORCH_CUDA_ARCH_LIST="8.0 8.6 8.9 9.0 10.0+PTX" \
    MAX_JOBS=160 \
    NVCC_THREADS=8 \
    CCACHE_DIR=/root/.ccache \
    CCACHE_MAXSIZE=20G


RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        software-properties-common ca-certificates curl wget git git-lfs gnupg && \
    add-apt-repository -y ppa:deadsnakes/ppa && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ninja-build cmake pkg-config ccache \
        libssl-dev zlib1g-dev libbz2-dev libreadline-dev libsqlite3-dev \
        libffi-dev liblzma-dev libxml2-dev libxslt1-dev \
        libsndfile1 libsox-dev ffmpeg \
        libopenmpi-dev openmpi-bin \
        libaio-dev libzstd-dev zstd \
        iproute2 iputils-ping net-tools rsync openssh-client \
        vim less htop tini \
        python3.12 python3.12-dev python3.12-venv && \
    curl -fsSL https://bootstrap.pypa.io/get-pip.py | python3.12 - && \
    update-alternatives --install /usr/bin/python  python  /usr/bin/python3.12 100 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 100 && \
    git lfs install && \
    rm -rf /var/log/* /usr/share/doc /usr/share/man /var/tmp/*


RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --upgrade pip setuptools wheel packaging && \
    python -m pip install \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch==2.11.0 torchaudio==2.11.0 torchvision==0.26.0

RUN mkdir -p /etc/pip && \
    printf '%s\n' \
        'torch==2.11.0' \
        'torchvision==0.26.0' \
        'torchaudio==2.11.0' \
        'cuda-bindings<13' \
        > /etc/pip/constraints.txt
ENV PIP_CONSTRAINT=/etc/pip/constraints.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install \
        "transformers>=4.56,<5.9" \
        "datasets>=3.0,<4.8.5" \
        "accelerate>=0.34" \
        "peft>=0.11,<0.20" \
        "trl>=0.15,<1.0" \
        "safetensors>=0.4" \
        "huggingface-hub>=0.24" \
        "modelscope>=1.23" \
        awscli pynvml py-cpuinfo deepspeed-kernels \
        tiktoken sentencepiece einops rouge tqdm matplotlib \
        "PyYAML>=5.4" json_repair addict attrdict binpacking dacite \
        fastapi "gradio<6.0" "uvicorn[standard]" openai oss2 \
        tensorboard wandb swanlab \
        scipy scikit-learn pandas pillow soundfile librosa \
        qwen_vl_utils qwen_omni_utils \
        icecream py-spy nvitop pre-commit \
        math_verify \
        liger-kernel \
        "ray[default]>=2.10"


RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ccache \
    DS_BUILD_OPS=1 \
    DS_BUILD_CCL_COMM=0 \
    DS_BUILD_SPARSE_ATTN=0 \
    DS_BUILD_STOCHASTIC_TRANSFORMER=0 \
    DS_BUILD_EVOFORMER_ATTN=0 \
    pip install --no-build-isolation \
        deepspeed==0.19.0 \
        --config-settings "--global-option=build_ext" \
        --config-settings "--global-option=-j${MAX_JOBS}" && \
    rm -rf /tmp/* /var/tmp/* /root/.cache/torch_extensions


RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --no-build-isolation --no-deps \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
        xformers==0.0.34


RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ccache \
    python -m pip install "flash-attn==2.8.3" --no-build-isolation && \
    rm -rf /tmp/* /var/tmp/*


RUN --mount=type=cache,target=/root/.cache/pip \
    --mount=type=cache,target=/root/.ccache \
    python -m pip install --no-build-isolation \
        "causal-conv1d>=1.4.0" && \
    python -m pip install \
        tilelang && \
    python -m pip install --no-build-isolation \
        "flash-linear-attention[conv1d]" \
        mamba-ssm && \
    rm -rf /tmp/* /var/tmp/* /root/.cache/torch_extensions


RUN --mount=type=cache,target=/root/.cache/pip \
    # Bump pins to satisfy vllm 0.20.2's strict version requirements where
    # it doesn't conflict with our other constraints.
    python -m pip install -U "setuptools>=77.0.3,<81" && \
    python -m pip install --force-reinstall --no-deps "numba==0.65.0" && \
    # Install vllm/lmdeploy themselves without their dependency closures.
    python -m pip install --no-deps --no-build-isolation \
        "vllm==0.20.2" \
        "lmdeploy==0.13.0" \
        "flashinfer-python==0.6.8.post1" \
        "flashinfer-cubin==0.6.8.post1" && \
    # vllm's runtime imports: structured-output / quantization / observability.
    python -m pip install \
        "compressed-tensors==0.15.0.1" \
        "lm-format-enforcer==0.11.3" \
        "llguidance>=1.3.0,<1.4.0" \
        "outlines_core==0.2.14" \
        "diskcache==5.6.3" \
        "lark==1.2.2" \
        "xgrammar>=0.1.32,<1.0.0" \
        "depyf==0.20.0" \
        "apache-tvm-ffi==0.1.9" \
        "fastsafetensors>=0.2.2" \
        "mistral_common[image]>=1.11.0" \
        "opencv-python-headless>=4.13.0" \
        "gguf>=0.17.0" \
        "openai-harmony>=0.0.3" \
        "anthropic>=0.71.0" \
        "model-hosting-container-standards>=0.1.13,<1.0.0" \
        mcp \
        "prometheus-fastapi-instrumentator>=7.0.0" \
        "opentelemetry-sdk>=1.27.0" \
        "opentelemetry-api>=1.27.0" \
        "opentelemetry-exporter-otlp>=1.27.0" \
        "opentelemetry-semantic-conventions-ai>=0.4.1" \
        cachetools blake3 pybase64 cbor2 ijson setproctitle \
        python-json-logger msgspec partial-json-parser \
        outlines fairscale cloudpickle pyzmq && \
    # Hopper/Blackwell-only kernels vllm dispatches to when available. These
    # are heavy (~2 GB combined) but enable serving fp8 / fp4 paths.
    python -m pip install \
        "nvidia-cudnn-frontend>=1.13.0,<1.19.0" \
        "nvidia-cutlass-dsl>=4.4.2" \
        "quack-kernels>=0.3.3" && \
    # lmdeploy runtime deps not already pulled in for vllm above.
    python -m pip install \
        fire mmengine-lite shortuuid


ARG SWIFT_REPO=https://github.com/iNeil77/ms-swift.git
ARG SWIFT_REF=v4.2.0-multiturn-sft
RUN --mount=type=cache,target=/root/.cache/pip \
    if git clone --depth 1 --branch ${SWIFT_REF} ${SWIFT_REPO} /opt/ms-swift 2>/dev/null; then \
        echo "Cloned ${SWIFT_REF} as branch/tag"; \
    else \
        echo "Falling back to fetch-by-revision for ${SWIFT_REF}"; \
        rm -rf /opt/ms-swift && \
        git init /opt/ms-swift && \
        cd /opt/ms-swift && \
        git remote add origin ${SWIFT_REPO} && \
        git fetch --depth 1 origin ${SWIFT_REF} && \
        git checkout FETCH_HEAD; \
    fi && \
    cd /opt/ms-swift && \
    python -m pip install -e . && \
    python -c "from swift.template.register import TEMPLATE_MAPPING; \
               from swift.agent_template import agent_template_map; \
               assert 'octolong' in TEMPLATE_MAPPING, 'octolong template not registered'; \
               assert 'octolong' in agent_template_map, 'octolong agent_template not registered'; \
               print('octolong template + agent_template registered OK')"

RUN find /usr/local/lib/python3.12 -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true ; \
    find /usr/local/lib/python3.12 -name "*.pyc" -delete 2>/dev/null || true ; \
    rm -rf \
        /root/.cache/pip \
        /root/.cache/torch_extensions \
        /tmp/* /var/tmp/* \
        /usr/share/doc /usr/share/man /usr/share/locale \
        /var/log/*


ENV TOKENIZERS_PARALLELISM=false \
    NCCL_NVLS_ENABLE=0 \
    NCCL_P2P_LEVEL=NVL \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    HF_HOME=/root/.cache/huggingface \
    HUGGINGFACE_HUB_CACHE=/root/.cache/huggingface/hub \
    TRANSFORMERS_CACHE=/root/.cache/huggingface/hub \
    PYTHONPATH=/opt/ms-swift


WORKDIR /opt/ms-swift

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/bin/bash"]
